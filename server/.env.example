# Copy to server/.env for local development. NEVER commit a real .env.
# On Render, set these in the dashboard (render.yaml marks secrets as sync: false).

# Postgres (Neon) connection string. Leave unset locally to use ./mynews.db (SQLite).
# Neon gives a URL like: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Shared secret for POST /admin/collect (manual + GitHub Actions hourly trigger).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Google Gemini API key (https://aistudio.google.com/apikey). Without it, AI sections report "not configured".
GEMINI_API_KEY=
# Optional override; default comes from prompts/model_config.json.
GEMINI_MODEL=

# Guardian Open Platform key for the globe archive (https://open-platform.theguardian.com/access/).
GUARDIAN_API_KEY=

# Wikimedia requires a contact URL or email in the User-Agent, otherwise Wikipedia answers 403.
# Use your repo URL or email. On Render, RENDER_EXTERNAL_URL is used when this is empty.
# When neither is set, background lookups are skipped and the app shows "No background resource available".
WIKI_CONTACT=

# Tuning (defaults shown).
RETENTION_HOURS=168
MAX_AI_CALLS_PER_RUN=6
AI_MIN_INTERVAL_SECONDS=7
AI_DAILY_LIMIT=200
EXPLORE_AI_RESERVE=60
MAX_BACKGROUND_LOOKUPS_PER_RUN=30
